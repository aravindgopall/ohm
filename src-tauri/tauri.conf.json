{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ohm",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "/",
        "title": "ohm",
        "width": 900,
        "height": 600,
        "visible": true
      },
      {
        "label": "picker",
        "url": "/picker",
        "title": "Paste Picker",
        "width": 720,
        "height": 520,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
